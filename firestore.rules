rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only uids listed in pairs/{pair}/members get in. Knowing the pair code is not enough (it is in the public
    // repo's history): the joinPair callable is the only way into members, and it writes with the Admin SDK
    function isMember(pairId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/pairs/$(pairId)/members/$(request.auth.uid));
    }

    // The pair doc only carries `locked` (written by lockPair); members read it for Ajustes
    match /pairs/{pairId} {
      allow get: if isMember(pairId);
    }

    match /pairs/{pairId}/members/{uid} {
      allow read: if isMember(pairId);
    }

    // Rutas explícitas pairs/{pair}/{colección}/{doc}: sin `**`, que también casaba /pairs y /pairs/{pair}
    match /pairs/{pairId}/{col}/{docId} {
      allow read, write: if col != 'members' && isMember(pairId);
    }

    // pairInvites/{hash}: Admin SDK only (createInvite, joinPair); no rule, so the client never reaches it
  }
}
